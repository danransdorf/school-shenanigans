     "===", "===", "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "5", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "2", ",", "6"}], "}"}]}], "}"}]}], ";"}], 
   "        ", 
   RowBox[{"(*", 
    RowBox[{"2", "\[Times]", "3", " ", "matrix", " ", "over", " ", "Z7"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"res", "=", 
     RowBox[{"CheckImageKernelFormZ7", "[", "m", "]"}]}], ";"}], "\n", 
   RowBox[{"PrettyPrintResultZ7", "[", "res", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "If", " ", "you", " ", "want", " ", "only", " ", "the", " ", "full", " ", 
     "image", " ", 
     RowBox[{"set", ":"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"imgSet", "=", 
      RowBox[{"FullImageZ7FromMatrix", "[", "m", "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PrettyPrintImageSetZ7", "[", "imgSet", "]"}], "*)"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]"}]}]], "Input",
