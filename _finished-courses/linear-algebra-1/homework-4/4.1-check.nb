       RowBox[{"(", 
        RowBox[{
         RowBox[{"Z7", "^", "3"}], "->", 
         RowBox[{"Z7", "^", "2"}]}], ")"}], "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "CheckImageKernelFormZ7", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CheckImageKernelFormZ7", "[", 
      RowBox[{"m_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "res", ",", "imgBasis", ",", "kerBasis", ",", "imgTarget", ",", 
         "kerTarget", ",", "imgOK", ",", "kerOK", ",", "dims", ",", 
         "imgSet"}], "}"}], ",", 
       RowBox[{
        RowBox[{"dims", "=", 
         RowBox[{"Dimensions", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dims", "=!=", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             
             RowBox[{"\"\<Error\>\"", 
              "->", "\"\<Matrix must be 2\[Times]3 to map Z7^3 -> Z7^2 for \
the specified target subspaces.\>\""}], ",", 
             RowBox[{"\"\<GivenDimensions\>\"", "->", "dims"}]}], "|>"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"KernelAndImageZ7", "[", "m", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imgBasis", "=", 
         RowBox[{"res", "[", "\"\<ImageBasis\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kerBasis", "=", 
         RowBox[{"res", "[", "\"\<KernelBasis\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imgTarget", "=", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kerTarget", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "4", ",", "1"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imgOK", "=", 
         RowBox[{"TrueQ", "@", 
          RowBox[{"SubspaceEqualZ7", "[", 
           RowBox[{"imgBasis", ",", "imgTarget"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kerOK", "=", 
         RowBox[{"TrueQ", "@", 
          RowBox[{"SubspaceEqualZ7", "[", 
           RowBox[{"kerBasis", ",", "kerTarget"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imgSet", "=", 
         RowBox[{"FullImageFromBasisZ7", "[", 
          RowBox[{"imgBasis", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<ImageMatches(3t,4t)\>\"", "->", "imgOK"}], ",", 
          RowBox[{"\"\<KernelMatches(3s,4t,s+t)\>\"", "->", "kerOK"}], ",", 
          RowBox[{"\"\<ComputedImageBasis\>\"", "->", 
           RowBox[{"Mod", "[", 
            RowBox[{"imgBasis", ",", "7"}], "]"}]}], ",", 
          RowBox[{"\"\<ComputedKernelBasis\>\"", "->", 
           RowBox[{"Mod", "[", 
            RowBox[{"kerBasis", ",", "7"}], "]"}]}], ",", 
          RowBox[{"\"\<ImageSet\>\"", "->", "imgSet"}], ",", 
          RowBox[{"\"\<ImageCardinality\>\"", "->", 
           RowBox[{"Length", "[", "imgSet", "]"}]}], ",", 
          RowBox[{"\"\<Rank\>\"", "->", 
           RowBox[{"res", "[", "\"\<Rank\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Nullity\>\"", "->", 
           RowBox[{"res", "[", "\"\<Nullity\>\"", "]"}]}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
     RowBox[{"==", 
